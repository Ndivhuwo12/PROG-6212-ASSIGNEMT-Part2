<Window x:Class="NdivhuwoCyberShieldPart2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ndivhuwo CyberShield Assistant - Part 2"
        Height="640" Width="1100"
        MinHeight="600" MinWidth="980"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#07111F">

    <!-- Window resources store reusable styles -->
    <Window.Resources>

        <!-- Style used for all quick topic buttons -->
        <Style x:Key="QuickButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#E5F4FF"/>
            <Setter Property="Background" Value="#123456"/>
            <Setter Property="BorderBrush" Value="#1D9BF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <!-- Main layout grid -->
    <Grid Margin="8">

        <!-- Creates left and right sections -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE PANEL -->
        <Border Grid.Column="0"
                CornerRadius="20"
                Background="#0B1B2E"
                BorderBrush="#1D9BF0"
                BorderThickness="1"
                Padding="14">

            <!-- Scroll viewer allows scrolling if content becomes too large -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>
                     <TextBlock Text="CYBER SHIELD" Foreground="#75D6FF" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Ndivhuwo" Foreground="#D7E8F7" FontSize="14" Margin="0,4,0,12"/>

                    <!-- ASCII logo container -->
                    <Border Background="#07111F"
                            CornerRadius="16"
                            Padding="10"
                            Margin="0,0,0,14">

                        <!-- Displays the ASCII logo -->
                        <TextBlock x:Name="AsciiLogoText"
                                   FontFamily="Consolas"
                                   FontSize="7"
                                   Foreground="#7CFFB2"
                                   TextWrapping="NoWrap"
                                   HorizontalAlignment="Center"/>

                    </Border>

                    <!-- User name label -->
                    <TextBlock Text="User Name"
                               Foreground="#B7C9D9"
                               FontWeight="SemiBold"/>

                    <!-- Textbox where the user enters their name -->
                    <TextBox x:Name="NameTextBox"
                             Margin="0,6,0,12"
                             Height="42"
                             Padding="10,0,10,0"
                             FontSize="16"
                             Text=""
                             VerticalContentAlignment="Center"
                             KeyDown="NameTextBox_KeyDown"/>

                    <!-- Button used to save the user's name -->
                    <Button Content="Save Name"
                            Height="32"
                            Click="SaveNameButton_Click"
                            Background="#1D9BF0"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <!-- Memory section heading -->
                    <TextBlock Text="Memory"
                               Foreground="#75D6FF"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,16,0,6"/>

                    <!-- Displays chatbot memory information -->
                    <TextBlock x:Name="MemoryTextBlock"
                               Foreground="#D7E8F7"
                               TextWrapping="Wrap"
                               LineHeight="20"/>

                    <!-- Example questions section -->
                    <TextBlock Text="Try asking"
                               Foreground="#75D6FF"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,16,0,6"/>

                    <!-- Shows example prompts for the user -->
                    <TextBlock Foreground="#D7E8F7"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Text="• I am worried about scams&#10;• Tell me about password safety&#10;• I am interested in privacy&#10;• Give me another tip&#10;• What do you remember about me?"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- RIGHT SIDE CHAT PANEL -->
        <Border Grid.Column="2"
                CornerRadius="22"
                Background="#F7FBFF"
                Padding="18">

            <Grid>

                <!-- Rows for header, chat area, quick buttons, and input -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top header section -->
                <DockPanel Margin="0,0,0,14">

                    <StackPanel DockPanel.Dock="Left">

                        <!-- Main chatbot title -->
                        <TextBlock Text="Cybersecurity Awareness Chatbot"
                                   Foreground="#07111F"
                                   FontSize="22"
                                   FontWeight="Bold"/>

                    </StackPanel>

                </DockPanel>

                <!-- Main chat display area -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="18"
                        BorderBrush="#D9E8F2"
                        BorderThickness="1"
                        Padding="14">

                    <!-- Scroll viewer for chat messages -->
                    <ScrollViewer x:Name="ChatScrollViewer"
                                  VerticalScrollBarVisibility="Auto">

                        <!-- Stack panel where chat bubbles appear -->
                        <StackPanel x:Name="ChatPanel"/>

                    </ScrollViewer>

                </Border>

                <!-- Quick topic buttons -->
                <WrapPanel Grid.Row="2"
                           Margin="0,14,0,6">

                    <Button Style="{StaticResource QuickButtonStyle}"
                            Content="Password"
                            Click="QuickTopic_Click"/>

                    <Button Style="{StaticResource QuickButtonStyle}"
                            Content="Phishing"
                            Click="QuickTopic_Click"/>

                    <Button Style="{StaticResource QuickButtonStyle}"
                            Content="Privacy"
                            Click="QuickTopic_Click"/>

                    <Button Style="{StaticResource QuickButtonStyle}"
                            Content="Scams"
                            Click="QuickTopic_Click"/>

                    <Button Style="{StaticResource QuickButtonStyle}"
                            Content="2FA"
                            Click="QuickTopic_Click"/>

                    <Button Style="{StaticResource QuickButtonStyle}"
                            Content="Tell me more"
                            Click="QuickTopic_Click"/>

                </WrapPanel>

                <!-- Bottom input section -->
                <Grid Grid.Row="3">

                    <!-- Creates textbox and send button columns -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- Textbox where the user types messages -->
                    <TextBox x:Name="InputTextBox"
                             Height="48"
                             Padding="12,0,12,0"
                             FontSize="16"
                             KeyDown="InputTextBox_KeyDown"
                             VerticalContentAlignment="Center"/>

                    <!-- Button used to send the message -->
                    <Button Grid.Column="1"
                            Content="Send"
                            Margin="10,0,0,0"
                            Click="SendButton_Click"
                            Background="#1D9BF0"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>